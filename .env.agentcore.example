# AgentCore docker-compose environment
# Copy to .env.agentcore and fill in values:
#   cp .env.agentcore.example .env.agentcore

# Service-to-service JWT secret (worker <-> orchestrator)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTBOX_SERVICE_SECRET=

# Also used as the JWT shared secret for local testing (callers mint tokens with this).
# In production, use JWKS_URI with Keycloak/Auth0 instead.
AGENTBOX_JWT_SECRET=${AGENTBOX_SERVICE_SECRET}

# AWS credentials for AgentCore (Bedrock) and S3 storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
